<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Multiple classes here open real X11 connections; Xlib is not thread-safe without
         XInitThreads, so running them concurrently under xUnit's default collection parallelism
         is unsafe — confirmed live (X11InputRecorderTests reliably hung the whole run). Same fix
         as AutomationStudio.Voice.Tests' real-hardware tests. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutomationStudio.Linux\AutomationStudio.Linux.csproj" />
    <ProjectReference Include="..\..\src\AutomationStudio.Abstractions\AutomationStudio.Abstractions.csproj" />
  </ItemGroup>

</Project>