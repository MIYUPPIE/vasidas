<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real hardware (the microphone) and real CPU-bound inference (Whisper) aren't safe under
         xUnit's default parallel-collections execution — confirmed live: the full suite reliably
         hung when collections ran in parallel, while every subset ran clean and fast in isolation. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutomationStudio.Voice\AutomationStudio.Voice.csproj" />
    <ProjectReference Include="..\..\src\AutomationStudio.Ai\AutomationStudio.Ai.csproj" />
    <ProjectReference Include="..\..\src\AutomationStudio.Bible\AutomationStudio.Bible.csproj" />
    <ProjectReference Include="..\..\src\AutomationStudio.Abstractions\AutomationStudio.Abstractions.csproj" />
  </ItemGroup>

</Project>
